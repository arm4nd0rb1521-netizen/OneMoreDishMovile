<?xml version="1.0" encoding="utf-8"?>
<!--
  Paso 3 - Inicio / Resumen del día (estilo FoodSync).
  IDs que usa InicioAdminFragment.java (NO cambiar):
    txt_home_ventas_monto, txt_home_pedidos_count, txt_home_ticket_prom,
    txt_home_mesas_fraccion, txt_home_mesas_porcentaje, txt_home_cocina_count
  ID NUEVO:
    prog_home_mesas -> anillo de ocupación (lo llena InicioAdminFragment)
  Se quitó el encabezado interno (saludo, título, campana y "SM" fijos):
  ahora el encabezado lo pone activity_principal.xml. Ningún Java lo usaba.
  La gráfica semanal, "Platillos más vendidos" y "Actividad reciente"
  siguen siendo de ejemplo (fijos), igual que antes.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="6dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        tools:ignore="UnusedAttribute">

        <!-- ===== Tarjeta destacada: Ventas de hoy ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tarjeta_venta_hoy"
            android:elevation="8dp"
            android:orientation="vertical"
            android:outlineAmbientShadowColor="@color/fs_degradado_fin"
            android:outlineSpotShadowColor="@color/fs_degradado_fin"
            android:padding="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Omd.Texto.SobreVino"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ventas de hoy"
                    android:textSize="14sp" />

                <TextView
                    style="@style/Omd.Badge.SobreVino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hoy" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_home_ventas_monto"
                style="@style/Omd.Numero.Blanco"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="$0.00" />

            <!-- Línea decorativa (no son datos reales) -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/ic_linea_ventas" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/txt_home_pedidos_count"
                    style="@style/Omd.Texto.SobreVino"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="0 pedidos" />

                <TextView
                    android:id="@+id/txt_home_ticket_prom"
                    style="@style/Omd.Texto.SobreVino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ticket prom. $0.00" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Métricas: Mesas | En cocina ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:orientation="horizontal">

            <!-- Mesas -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tarjeta_blanca"
                android:elevation="2dp"
                android:outlineSpotShadowColor="@color/fs_primario"
                android:outlineAmbientShadowColor="@color/fs_primario"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp">

                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:id="@+id/prog_home_mesas"
                        style="@style/Omd.Anillo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:max="100"
                        android:progress="0"
                        app:indicatorColor="@color/fs_primario"
                        app:indicatorSize="64dp"
                        app:trackThickness="7dp" />

                    <TextView
                        android:id="@+id/txt_home_mesas_fraccion"
                        style="@style/Omd.Texto.Fuerte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="0/0"
                        android:textSize="15sp" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Omd.Texto.Fuerte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mesas"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/txt_home_mesas_porcentaje"
                        style="@style/Omd.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0% ocupado"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- En cocina -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tarjeta_blanca"
                android:elevation="2dp"
                android:outlineSpotShadowColor="@color/fs_primario"
                android:outlineAmbientShadowColor="@color/fs_primario"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/Omd.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="En cocina"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txt_home_cocina_count"
                    style="@style/Omd.Numero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="28sp" />

                <TextView
                    style="@style/Omd.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mayor espera 12:40"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== Ingresos de la semana (ejemplo) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tarjeta_blanca"
            android:elevation="2dp"
            android:outlineSpotShadowColor="@color/fs_primario"
            android:outlineAmbientShadowColor="@color/fs_primario"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Omd.TituloTarjeta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Ingresos de la semana" />

                <TextView
                    style="@style/Omd.Etiqueta.Tenue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Datos de ejemplo" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="60dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_barra_grafica" />

                    <TextView
                        style="@style/Omd.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Jue"
                        android:textColor="@color/fs_texto_suave"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="82dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_barra_grafica" />

                    <TextView
                        style="@style/Omd.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Vie"
                        android:textColor="@color/fs_texto_suave"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="108dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_barra_grafica" />

                    <TextView
                        style="@style/Omd.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Sáb"
                        android:textColor="@color/fs_texto_suave"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_barra_grafica" />

                    <TextView
                        style="@style/Omd.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Dom"
                        android:textColor="@color/fs_texto_suave"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_barra_grafica" />

                    <TextView
                        style="@style/Omd.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Lun"
                        android:textColor="@color/fs_texto_suave"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="72dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_barra_grafica" />

                    <TextView
                        style="@style/Omd.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Mar"
                        android:textColor="@color/fs_texto_suave"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="bottom|center_horizontal"
                    android:orientation="vertical">

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="38dp"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/bg_barra_grafica_activa" />

                    <TextView
                        style="@style/Omd.Etiqueta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Mié"
                        android:textColor="@color/fs_primario_oscuro"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <!-- ===== Platillos más vendidos (ejemplo) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tarjeta_blanca"
            android:elevation="2dp"
            android:outlineSpotShadowColor="@color/fs_primario"
            android:outlineAmbientShadowColor="@color/fs_primario"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Omd.TituloTarjeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Platillos más vendidos" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Omd.Texto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tacos al Pastor"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/Omd.Etiqueta.Tenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="90%" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    style="@style/Omd.Progreso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="90" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Omd.Texto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Enchiladas Suizas"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/Omd.Etiqueta.Tenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="68%" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    style="@style/Omd.Progreso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="68" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Omd.Texto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Agua de Jamaica"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/Omd.Etiqueta.Tenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="45%" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    style="@style/Omd.Progreso"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progress="45" />
            </LinearLayout>

        </LinearLayout>

        <!-- ===== Actividad reciente (ejemplo) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_tarjeta_blanca"
            android:elevation="2dp"
            android:outlineSpotShadowColor="@color/fs_primario"
            android:outlineAmbientShadowColor="@color/fs_primario"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                style="@style/Omd.TituloTarjeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Actividad reciente" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/punto_vino" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Omd.Texto.Fuerte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Venta #109 cobrada · $90.00"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/Omd.Etiqueta.Tenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="19:44" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/punto_salvia" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Omd.Texto.Fuerte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Ticket #109 listo para entregar"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/Omd.Etiqueta.Tenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="19:43" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/punto_ambar" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Omd.Texto.Fuerte"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mesa 2 abrió cuenta"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/Omd.Etiqueta.Tenue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="19:02" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
