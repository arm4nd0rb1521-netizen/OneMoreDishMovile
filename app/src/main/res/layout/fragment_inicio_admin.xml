<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            style="@style/Omd.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_bienvenido"
            android:textSize="34sp"
            android:textStyle="bold|italic" />

        <TextView
            style="@style/Omd.Texto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/admin_resumen_texto" />

        <include
            layout="@layout/tarjeta_ocupacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_platillos"
                style="@style/Omd.Boton.Tonal"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="@string/platillos"
                app:icon="@drawable/ic_nav_menu" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_mesas"
                style="@style/Omd.Boton.Tonal"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="@string/nav_mesas"
                app:icon="@drawable/ic_nav_mesas" />
        </LinearLayout>

        <TextView
            style="@style/Omd.Seccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="8dp"
            android:text="@string/mapa_mesas" />

        <GridLayout
            android:id="@+id/grid_mesas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:columnCount="3" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>