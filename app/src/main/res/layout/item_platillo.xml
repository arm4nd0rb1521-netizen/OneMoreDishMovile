<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:layout_gravity="fill"
    android:layout_margin="6dp"
    android:background="@drawable/bg_tarjeta_platillo"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:background="@drawable/bg_foto_platillo">

            <TextView
                android:id="@+id/pl_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:textSize="44sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/pl_nombre"
            style="@style/Omd.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/pl_desc"
            style="@style/Omd.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/pl_precio"
            style="@style/Omd.Titulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/rosa_principal"
            android:textSize="20sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/pl_opciones"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/circulo_blanco"
        android:contentDescription="@string/modificar_titulo"
        android:padding="7dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_nav_mas"
        android:tint="@color/vino" />
</FrameLayout>