<?xml version="1.0" encoding="utf-8"?>
<!--
  Paso 6 - Tarjeta de platillo (estilo FoodSync).
  IDs que usa MenuFragment.java (NO cambiar):
    pl_emoji, pl_nombre, pl_desc, pl_precio, pl_opciones
  No hay IDs nuevos. La raíz ahora es MaterialCardView para que la foto
  rayada se recorte con las esquinas redondeadas.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Omd.Tarjeta"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:layout_gravity="fill"
    android:layout_margin="6dp"
    app:cardElevation="2dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- "Foto": fondo rayado con el emoji del platillo -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:background="@drawable/bg_rayas_platillo">

                <TextView
                    android:id="@+id/pl_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="42sp" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/pl_nombre"
                    style="@style/Omd.TituloTarjeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/pl_desc"
                    style="@style/Omd.Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textSize="12sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/pl_precio"
                    style="@style/Omd.Texto.Fuerte"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/fs_primario"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botón ⋯ (modificar / eliminar) -->
        <ImageButton
            android:id="@+id/pl_opciones"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:background="@drawable/bg_boton_circular"
            android:contentDescription="@string/modificar_titulo"
            android:padding="6dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nav_mas"
            app:tint="@color/fs_primario" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>