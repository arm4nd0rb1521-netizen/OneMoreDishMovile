<?xml version="1.0" encoding="utf-8"?>
<!--
  Paso 8 - estilo FoodSync.
  IDs que usa el Java (NO cambiar): card_personal, txt_personal_iniciales, txt_personal_nombre, txt_personal_puesto_horario, txt_personal_estado
  No hay IDs nuevos.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_personal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_tarjeta_blanca"
    android:elevation="2dp"
    android:foreground="?attr/selectableItemBackground"
    android:outlineAmbientShadowColor="@color/fs_primario"
    android:outlineSpotShadowColor="@color/fs_primario"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true">

    <TextView
        android:id="@+id/txt_personal_iniciales"
        style="@style/Omd.Texto.Fuerte"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/bg_icono_suave"
        android:gravity="center"
        android:textColor="@color/fs_primario"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_personal_nombre"
            style="@style/Omd.Texto.Fuerte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txt_personal_puesto_horario"
            style="@style/Omd.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_personal_estado"
        style="@style/Omd.Leyenda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>