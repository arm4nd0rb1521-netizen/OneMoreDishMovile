<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_personal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_tarjeta_blanca"
    android:elevation="2dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp"
    android:clickable="true"
    android:focusable="true"
    android:backgroundTint="@color/blanco">

    <TextView
        android:id="@+id/txt_personal_iniciales"
        style="@style/Omd.Titulo"
        android:layout_width="46dp"
        android:layout_height="46dp"
        android:background="@drawable/circulo_crema"
        android:gravity="center"
        android:textColor="@color/vino"
        android:textSize="16sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_personal_nombre"
            style="@style/Omd.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_personal_puesto_horario"
            style="@style/Omd.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/txt_personal_estado"
        style="@style/Omd.Leyenda"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="13sp" />
</LinearLayout>
