<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Selector de Vista (Nueva Venta vs Calendario / Historial) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupo_modo_ventas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="10dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_modo_venta"
                style="@style/Omd.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="🛒 Realizar Venta" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_modo_calendario"
                style="@style/Omd.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📅 Ventas por Fecha" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- ================= CONTENEDOR 1: NUEVA VENTA ================= -->
    <RelativeLayout
        android:id="@+id/layout_nueva_venta"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="visible">

        <!-- Buscador de Platillos -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_buscar_venta"
            style="@style/Omd.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:hint="@string/buscar_platillo"
            app:startIconDrawable="@drawable/ic_buscar"
            app:startIconTint="@color/texto_suave">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txt_buscar_venta"
                style="@style/Omd.Campo.Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Grid de Platillos con scroll -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bar_total_venta"
            android:layout_below="@id/til_buscar_venta"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingTop="8dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <GridLayout
                    android:id="@+id/grid_platillos_venta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2" />

                <TextView
                    android:id="@+id/txt_vacio_venta"
                    style="@style/Omd.Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="32dp"
                    android:text="@string/menu_sin_resultados"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Barra inferior del Total (Sticky Footer) -->
        <LinearLayout
            android:id="@+id/bar_total_venta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/blanco_suave"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_resumen_articulos"
                    style="@style/Omd.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 artículos seleccionados" />

                <TextView
                    android:id="@+id/txt_total_acumulado"
                    style="@style/Omd.Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="@color/vino"
                    android:textSize="20sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ver_pedido"
                style="@style/Omd.Boton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:enabled="false"
                android:text="Ver Pedido ➔"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- ================= CONTENEDOR 2: HISTORIAL Y CALENDARIO ================= -->
    <LinearLayout
        android:id="@+id/layout_calendario_ventas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:visibility="gone">

        <!-- Selector de Fecha / Calendario -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_tarjeta_blanca"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <ImageButton
                android:id="@+id/btn_fecha_anterior"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Día anterior"
                android:src="@drawable/ic_flecha_izq"
                app:tint="@color/vino" />

            <TextView
                android:id="@+id/txt_fecha_seleccionada"
                style="@style/Omd.Titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="15 Octubre 2024"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btn_fecha_siguiente"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Día siguiente"
                android:src="@drawable/ic_flecha_der"
                app:tint="@color/vino" />

            <ImageButton
                android:id="@+id/btn_abrir_calendario"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/circulo_crema"
                android:contentDescription="Abrir calendario"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_calendario"
                app:tint="@color/vino" />
        </LinearLayout>

        <!-- Tarjeta Resumen Metricas del Día -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_pastilla"
            android:orientation="horizontal"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/Omd.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Vendido" />

                <TextView
                    android:id="@+id/txt_metric_monto"
                    style="@style/Omd.Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="@color/vino"
                    android:textSize="18sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/borde_boton_contorno" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    style="@style/Omd.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pedidos" />

                <TextView
                    android:id="@+id/txt_metric_pedidos"
                    style="@style/Omd.Titulo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/vino"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Lista de Ventas del día -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/lista_historial_ventas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txt_sin_ventas_fecha"
                    style="@style/Omd.Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="32dp"
                    android:text="@string/sin_ventas_fecha"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</LinearLayout>
