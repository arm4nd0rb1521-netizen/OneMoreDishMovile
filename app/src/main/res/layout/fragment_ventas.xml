<?xml version="1.0" encoding="utf-8"?>
<!--
  Paso 7 - Ventas (estilo FoodSync).
  IDs que usa VentasFragment.java (NO cambiar):
    grupo_modo_ventas, chip_modo_venta, chip_modo_calendario,
    layout_nueva_venta, til_buscar_venta, txt_buscar_venta, grid_platillos_venta,
    txt_vacio_venta, bar_total_venta, txt_resumen_articulos, txt_total_acumulado,
    btn_ver_pedido, layout_calendario_ventas, btn_fecha_anterior,
    txt_fecha_seleccionada, btn_fecha_siguiente, btn_abrir_calendario,
    txt_metric_monto, txt_metric_pedidos, lista_historial_ventas, txt_sin_ventas_fecha
  No hay IDs nuevos.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Selector de vista: Realizar venta | Ventas por fecha -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupo_modo_ventas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_modo_venta"
                style="@style/Omd.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Realizar venta" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_modo_calendario"
                style="@style/Omd.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ventas por fecha" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- ================= CONTENEDOR 1: NUEVA VENTA ================= -->
    <RelativeLayout
        android:id="@+id/layout_nueva_venta"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="visible">

        <!-- Buscador redondo -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_buscar_venta"
            style="@style/Omd.Buscador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            app:startIconTint="@color/fs_texto_suave">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/txt_buscar_venta"
                style="@style/Omd.Campo.Texto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/buscar_platillo"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingTop="14dp"
                android:paddingBottom="14dp"
                android:textColorHint="@color/fs_texto_tenue" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Cuadrícula de platillos -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bar_total_venta"
            android:layout_below="@id/til_buscar_venta"
            android:clipToPadding="false"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <GridLayout
                    android:id="@+id/grid_platillos_venta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:columnCount="2" />

                <TextView
                    android:id="@+id/txt_vacio_venta"
                    style="@style/Omd.Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_tarjeta_blanca"
                    android:gravity="center"
                    android:padding="32dp"
                    android:text="@string/menu_sin_resultados"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Barra del total: tarjeta blanca flotante -->
        <LinearLayout
            android:id="@+id/bar_total_venta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_tarjeta_blanca"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:outlineAmbientShadowColor="@color/fs_primario"
            android:outlineSpotShadowColor="@color/fs_primario"
            android:paddingStart="18dp"
            android:paddingTop="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            tools:ignore="UnusedAttribute">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_resumen_articulos"
                    style="@style/Omd.Etiqueta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0 artículos seleccionados"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txt_total_acumulado"
                    style="@style/Omd.Numero"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="$0.00"
                    android:textColor="@color/fs_primario"
                    android:textSize="22sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_ver_pedido"
                style="@style/Omd.Boton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:enabled="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="Ver pedido"
                android:textSize="14sp"
                app:icon="@drawable/ic_flecha_der"
                app:iconGravity="end"
                app:iconSize="18dp" />
        </LinearLayout>
    </RelativeLayout>

    <!-- ================= CONTENEDOR 2: VENTAS POR FECHA ================= -->
    <LinearLayout
        android:id="@+id/layout_calendario_ventas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:visibility="gone"
        tools:ignore="UnusedAttribute">

        <!-- Selector de fecha -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_tarjeta_blanca"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:outlineAmbientShadowColor="@color/fs_primario"
            android:outlineSpotShadowColor="@color/fs_primario"
            android:paddingStart="8dp"
            android:paddingTop="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp">

            <ImageButton
                android:id="@+id/btn_fecha_anterior"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Día anterior"
                android:src="@drawable/ic_flecha_izq"
                app:tint="@color/fs_primario" />

            <TextView
                android:id="@+id/txt_fecha_seleccionada"
                style="@style/Omd.Texto.Fuerte"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="15sp"
                tools:text="25 de noviembre, 2026" />

            <ImageButton
                android:id="@+id/btn_fecha_siguiente"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Día siguiente"
                android:src="@drawable/ic_flecha_der"
                app:tint="@color/fs_primario" />

            <ImageButton
                android:id="@+id/btn_abrir_calendario"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_icono_suave"
                android:contentDescription="Abrir calendario"
                android:padding="9dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_calendario"
                app:tint="@color/fs_primario" />
        </LinearLayout>

        <!-- Tarjeta destacada vino: Total vendido | Pedidos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_tarjeta_venta_hoy"
            android:baselineAligned="false"
            android:elevation="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:outlineAmbientShadowColor="@color/fs_degradado_fin"
            android:outlineSpotShadowColor="@color/fs_degradado_fin"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Omd.Texto.SobreVino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total vendido" />

                <TextView
                    android:id="@+id/txt_metric_monto"
                    style="@style/Omd.Numero.Blanco"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="$0.00"
                    android:textSize="32sp" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="16dp"
                android:background="@color/fs_blanco_translucido" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    style="@style/Omd.Texto.SobreVino"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pedidos" />

                <TextView
                    android:id="@+id/txt_metric_pedidos"
                    style="@style/Omd.Numero.Blanco"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="0"
                    android:textSize="28sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Omd.Seccion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="18dp"
            android:text="Tickets del día" />

        <!-- Lista de ventas del día -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/lista_historial_ventas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/txt_sin_ventas_fecha"
                    style="@style/Omd.Etiqueta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_tarjeta_blanca"
                    android:gravity="center"
                    android:padding="32dp"
                    android:text="@string/sin_ventas_fecha"
                    android:visibility="gone" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</LinearLayout>