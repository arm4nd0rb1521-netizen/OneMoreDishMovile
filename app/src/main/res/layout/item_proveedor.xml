<?xml version="1.0" encoding="utf-8"?>
<!--
  Paso 8 - estilo FoodSync.
  IDs que usa el Java (NO cambiar): txt_prov_avatar, txt_prov_nombre, txt_prov_producto, txt_prov_contacto
  No hay IDs nuevos.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_tarjeta_blanca"
    android:elevation="2dp"
    android:foreground="?attr/selectableItemBackground"
    android:outlineAmbientShadowColor="@color/fs_primario"
    android:outlineSpotShadowColor="@color/fs_primario"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Avatar / Emoji de perfil -->
    <TextView
        android:id="@+id/txt_prov_avatar"
        style="@style/Omd.Texto.Fuerte"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_icono_suave"
        android:gravity="center"
        android:textSize="22sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/txt_prov_nombre"
            style="@style/Omd.Texto.Fuerte"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txt_prov_producto"
            style="@style/Omd.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/fs_primario"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/txt_prov_contacto"
            style="@style/Omd.Etiqueta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/fs_texto_tenue"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>