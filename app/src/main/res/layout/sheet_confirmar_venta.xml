<?xml version="1.0" encoding="utf-8"?>
<!--
  Paso 7 - Hoja "Resumen del pedido".
  IDs que usa VentasFragment.java (sin cambios): lista_confirmacion, combo_mesa_destino,
  txt_comentarios_cocina, txt_total_confirmacion, btn_confirmar_enviar_cocina
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="4dp"
    android:paddingEnd="22dp"
    android:paddingBottom="28dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tint="@color/fs_rosa_barra" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Omd.Titulo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/resumen_pedido"
            android:textSize="22sp" />

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_icono_suave"
            android:contentDescription="@string/titulo_cocina"
            android:padding="9dp"
            android:src="@drawable/ic_cocina"
            app:tint="@color/fs_primario" />
    </LinearLayout>

    <TextView
        style="@style/Omd.Etiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Revisa los detalles antes de registrar la venta y notificar a cocina" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:layout_weight="1"
        android:background="@drawable/bg_tarjeta_blanca"
        android:maxHeight="220dp"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <LinearLayout
            android:id="@+id/lista_confirmacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </androidx.core.widget.NestedScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="14dp" />

    <!-- Selector de Destino (Mesa / Para llevar) -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Omd.Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/seleccionar_mesa"
        app:endIconMode="dropdown_menu">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/combo_mesa_destino"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/fs_texto"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Comentarios para cocina -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Omd.Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/comentarios_cocina">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/txt_comentarios_cocina"
            style="@style/Omd.Campo.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/comentarios_hint"
            android:inputType="textCapSentences"
            android:maxLines="2" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Fila de Total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Omd.Texto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/total"
            android:textColor="@color/fs_titulo"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_total_confirmacion"
            style="@style/Omd.Numero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/fs_primario"
            android:textSize="26sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_confirmar_enviar_cocina"
        style="@style/Omd.Boton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="16dp"
        android:text="Enviar a cocina y registrar venta"
        app:icon="@drawable/ic_cocina"
        app:iconTint="@color/blanco" />
</LinearLayout>