<?xml version="1.0" encoding="utf-8"?>
<!--
  Paso 8 - estilo FoodSync.
  IDs que usa el Java (sin cambios): sheet_titulo_personal, txt_nombre_personal, txt_usuario_personal, combo_puesto_personal, combo_horario_personal, combo_estado_personal, btn_guardar_personal, btn_eliminar_personal_sheet
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="22dp"
    android:paddingTop="4dp"
    android:paddingEnd="22dp"
    android:paddingBottom="28dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:tint="@color/fs_rosa_barra" />

    <TextView
        android:id="@+id/sheet_titulo_personal"
        style="@style/Omd.Titulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="22sp" />

    <TextView
        style="@style/Omd.Etiqueta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Ingresa los datos y credenciales del colaborador" />

    <!-- Nombre Completo -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Omd.Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:hint="@string/nombre_completo">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/txt_nombre_personal"
            style="@style/Omd.Campo.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Usuario de la app -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Omd.Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/usuario_hint"
        app:prefixText="@string/arroba">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/txt_usuario_personal"
            style="@style/Omd.Campo.Texto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Puesto (Dropdown) -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Omd.Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/puesto"
        app:endIconMode="dropdown_menu">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/combo_puesto_personal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/fs_texto"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Horario (Dropdown) -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Omd.Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="@string/horario"
        app:endIconMode="dropdown_menu">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/combo_horario_personal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/fs_texto"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Estado (Dropdown) -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Omd.Campo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="Estado del colaborador"
        app:endIconMode="dropdown_menu">

        <com.google.android.material.textfield.MaterialAutoCompleteTextView
            android:id="@+id/combo_estado_personal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/fs_texto"
            android:textSize="15sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_guardar_personal"
        style="@style/Omd.Boton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="@string/guardar_cambios" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_eliminar_personal_sheet"
        style="@style/Omd.Boton.Contorno"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="@string/eliminar_platillo"
        android:textColor="@color/error"
        app:strokeColor="@color/error"
        android:visibility="gone" />
</LinearLayout>