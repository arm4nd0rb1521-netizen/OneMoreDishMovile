<?xml version="1.0" encoding="utf-8"?>
<!--
  Paso 5 - Tarjeta de ticket de cocina (estilo FoodSync).
  IDs que usa CocinaFragment.java (NO cambiar):
    txt_cocina_ticket, txt_cocina_hora, txt_cocina_destino, lista_items_pedido,
    txt_cocina_comentarios, grupo_estado_cocina, chip_pendiente, chip_preparacion, chip_listo
  No hay IDs nuevos.
  El anillo es decorativo: enmarca la hora del pedido, no mide tiempo transcurrido.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_tarjeta_blanca"
    android:elevation="2dp"
    android:orientation="vertical"
    android:outlineAmbientShadowColor="@color/fs_primario"
    android:outlineSpotShadowColor="@color/fs_primario"
    android:padding="16dp"
    tools:ignore="UnusedAttribute">

    <!-- Encabezado: anillo con hora | Ticket + destino -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txt_cocina_hora"
            style="@style/Omd.Texto.Fuerte"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_anillo_tiempo"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="14sp"
            tools:text="19:44" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_cocina_ticket"
                style="@style/Omd.TituloTarjeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                tools:text="Ticket #100" />

            <TextView
                android:id="@+id/txt_cocina_destino"
                style="@style/Omd.Etiqueta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                tools:text="Mesa 1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Platillos del pedido (los agrega CocinaFragment) -->
    <LinearLayout
        android:id="@+id/lista_items_pedido"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical" />

    <!-- Comentarios para cocina -->
    <TextView
        android:id="@+id/txt_cocina_comentarios"
        style="@style/Omd.Etiqueta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_badge"
        android:padding="10dp"
        android:textColor="@color/fs_texto"
        android:textSize="13sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/fs_borde_tarjeta" />

    <!-- Estado del ticket -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupo_estado_cocina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:chipSpacingHorizontal="8dp"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_pendiente"
                style="@style/Omd.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendiente" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_preparacion"
                style="@style/Omd.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En preparación" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_listo"
                style="@style/Omd.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Listo" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
</LinearLayout>