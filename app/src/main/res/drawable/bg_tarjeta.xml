<?xml version="1.0" encoding="utf-8"?>
<!-- NUEVO. Tarjeta blanca con sombra rosada suave -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/fs_sombra" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/fs_tarjeta" />
            <stroke android:width="1dp" android:color="@color/fs_borde_tarjeta" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</layer-list>