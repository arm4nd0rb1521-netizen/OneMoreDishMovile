<?xml version="1.0" encoding="utf-8"?>
<!-- NUEVO (Paso 5). Anillo decorativo alrededor de la hora del ticket -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/fs_tarjeta" />
            <stroke android:width="6dp" android:color="@color/fs_rosa_pista" />
        </shape>
    </item>
    <item
        android:bottom="1dp"
        android:left="1dp"
        android:right="1dp"
        android:top="1dp">
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="4dp" android:color="@color/fs_primario_oscuro" />
        </shape>
    </item>
</layer-list>