<?xml version="1.0" encoding="utf-8"?>
<!-- NUEVO. Para ProgressBar horizontal: android:progressDrawable="@drawable/progreso_platillo" -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/fs_rosa_pista" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <gradient android:angle="0" android:startColor="@color/fs_rosa_medio" android:endColor="@color/fs_primario" />
                <corners android:radius="4dp" />
            </shape>
        </clip>
    </item>
</layer-list>